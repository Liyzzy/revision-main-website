---
import { footerData } from '../navigation';
import Icon from './ui/Icon.astro';

const isPlaceholder = (href: string) => !href || href === '#';
---

<footer class="max-w-7xl mx-auto px-4 sm:px-6 py-16 border-t border-border">
  <div class="flex flex-col lg:flex-row gap-12 justify-between">

    <div>

      <a href="/" class="font-display font-semibold text-[20px] tracking-tight text-text no-underline">
        Re<span class="text-brand-400 px-[2px]" aria-hidden="true">·</span>Vision Digital
      </a>
      <p class="mt-3 text-sm text-text-faint max-w-xs">
        Websites for small businesses in Sabah.
      </p>

    </div>

    <div class="flex flex-col sm:flex-row gap-8 sm:gap-16">
      {footerData.links.map((column) => (
        <div>
          <h3 class="font-bold mb-3">{column.title}</h3>
          <ul class="space-y-2">
            {column.links.map((link) => (
              <li><a href={link.href} class="text-text-muted hover:text-brand-400 text-sm">{link.text}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-12 pt-8 border-t border-border">
    <p class="text-text-faint text-sm">{footerData.footNote}</p>
    <div class="flex gap-4">
      {footerData.socialLinks.map((social) =>
        isPlaceholder(social.href) ? (
          <span
            class="text-text-faint/50 cursor-default"
            title={`${social.ariaLabel} — link not set yet`}
            aria-hidden="true"
          >
            <Icon name={social.icon} class="w-5 h-5" />
          </span>
        ) : (
          <a
            href={social.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={social.ariaLabel}
            class="text-text-muted hover:text-brand-400"
          >
            <Icon name={social.icon} class="w-5 h-5" />
          </a>
        )
      )}
    </div>
  </div>
</footer>
