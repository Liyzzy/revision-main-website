---
import type { Package } from '../../data/packages';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { whatsappLink } from '../../navigation';

type Props = Package;

const {
  name, audience, price, period,
  features, featured = false, badge, cta, ctaMessage,
} = Astro.props;

// Decides which of the two price treatments to use.
const isNumeric = typeof price === 'number';
---

<!--
  flex-1 makes this fill the <li> horizontally; the flex parent's default
  align-items: stretch fills it vertically, minus any margin. That's what
  lets `lg:my-4` inset the two side cards without breaking the grid.
-->
<article
  class:list={[
    'flex-1 flex flex-col rounded-lg border p-6',
    featured
      ? 'border-brand-500 shadow-lg'
      : 'border-border lg:my-4',
  ]}
>

  <!-- Badge row renders even when empty, so the plan names across all
       three cards land on the same baseline. -->
  <div class="h-6 mb-4 flex items-center">
    {badge && (
      <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand-600">
        {badge}
      </span>
    )}
  </div>

  <h3 class="text-xl font-bold font-display">{name}</h3>
  <p class="text-text-muted text-sm mt-1">{audience}</p>

  <!-- Three separate elements, so no one string can outgrow the card.
       items-baseline sits "RM" on the same line as the digits. -->
  <p class="mt-6 flex items-baseline gap-1.5">
    {isNumeric && <span class="text-base font-bold text-text-muted">RM</span>}
    <span
      class:list={[
        'font-extrabold font-display tracking-tight',
        isNumeric ? 'text-2xl tabular-nums' : 'text-xl',
      ]}
    >{price}</span>
  </p>
  <p class="text-text-muted text-sm mt-1">{period}</p>

  <div class="h-px bg-border my-6" aria-hidden="true"></div>

  <ul class="flex flex-col gap-3 text-sm">
    {features.map((feature) => (
      <li class="flex items-start gap-3">
        <!-- shrink-0 is load-bearing: without it the circle squashes
             into an oval as soon as a feature wraps to two lines. -->
        <span
          class="shrink-0 mt-0.5 w-5 h-5 rounded-full bg-brand-50 flex items-center justify-center"
          aria-hidden="true"
        >
          <Icon name="tabler:check" class="w-3.5 h-3.5 text-brand-600" />
        </span>
        <span>{feature}</span>
      </li>
    ))}
  </ul>

  <!-- mt-auto swallows the leftover vertical space, pinning the button
       to the bottom however many features sit above it. -->
  <div class="mt-auto pt-8">
    <Button
      variant={featured ? 'primary' : 'secondary'}
      href={whatsappLink(ctaMessage)}
      target="_blank"
      class="w-full justify-center"
    >
      {cta}
    </Button>
  </div>
</article>