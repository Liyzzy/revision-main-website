---
import type { TeamMember } from '../../data/team';
import { Image } from 'astro:assets';

type Props = TeamMember;
const { photo, name, university, position} = Astro.props;

const words = name.split(' ');
const initials = words[0][0] + words[words.length - 1][0];
---

<article class="border border-border rounded-lg p-6 h-full flex flex-col">
  {
    photo ? (
        <Image
            src={photo}
            alt={`Photo of ${name}`}
            loading="lazy"
            class="w-24 h-24 rounded-full object-cover mx-auto mb-4"
        />
    ) : (
        <div
            class="w-24 h-24 rounded-full bg-brand-500 mx-auto mb-4 flex items-center justify-center"
            aria-hidden="true"
        >
            <span class="text-[20px] font-bold font-display text-white">{initials}</span>
        </div>
    )
  }
  <h3 class="text-xl font-bold font-display">{name}</h3>
  <p class="text-text-muted text-sm my-2 flex-1">{position}</p>
  <p class="text-text-muted text-sm my-2 flex-1">{university}</p>
</article>
