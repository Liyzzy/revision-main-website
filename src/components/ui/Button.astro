---
import Icon from './Icon.astro';
import { twMerge } from 'tailwind-merge';
import type { CallToAction as Props} from '~/types';

const {
    variant = 'secondary',
    target,
    text = Astro.slots.render('default'),
    icon = '',
    class: className = '',
    type,
    ...rest
} = Astro.props;

const variants: Record<string, string> = {
    primary: 'inline-flex items-center gap-2 bg-brand-400 hover:bg-brand-500 text-white text-sm font-semibold px-5 py-2 rounded-full transition-all no-underline',
    secondary: 'inline-flex items-center gap-2 border border-border text-text hover:bg-surface-2 text-sm font-semibold px-5 py-2 rounded-full transition-all no-underline',
    tertiary: 'inline-flex items-center gap-2 border border-border text-text hover:bg-surface-2 text-sm font-semibold px-5 py-2 rounded-full transition-all no-underline',
    link: 'inline-flex items-center gap-1 text-brand-400 hover:text-brand-500 underline-offset-4 hover:underline',
};
---

{
  type === 'button' || type === 'submit' || type === 'reset' ? (
    <button type={type} class={twMerge(variants[variant] || '', className)} {...rest}>
      <Fragment set:html={text} />
      {icon && <Icon name={icon} class="w-5 h-5 ml-1 -mr-1.5 rtl:mr-1 rtl:-ml-1.5 inline-block" />}
    </button>
  ) : (
    <a
      class={twMerge(variants[variant] || '', className)}
      {...(target ? { target: target, rel: 'noopener noreferrer' } : {})}
      {...rest}
    >
      <Fragment set:html={text} />
      {icon && <Icon name={icon} class="w-5 h-5 ml-1 -mr-1.5 rtl:mr-1 rtl:-ml-1.5 inline-block" />}
    </a>
  )
}

