---
import Icon from '../ui/Icon.astro';
import { whatsappLink } from '../../navigation';
---

<a
  href={whatsappLink()}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50 p-4 bg-green-500 text-white rounded-full shadow-lg hover:bg-green-600 transition-transform hover:scale-110 flex items-center justify-center"
  aria-label="Chat on WhatsApp"
>
  <Icon name="tabler:brand-whatsapp" class="w-8 h-8" />
</a>