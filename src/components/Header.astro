---
import { headerData } from '../navigation';

const whatsappHref = headerData.actions[0]?.href ?? '#';
const whatsappText = headerData.actions[0]?.text ?? 'WhatsApp Us';
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between">

    <a
      href="/"
      class="font-display font-semibold text-[20px] tracking-tight text-text no-underline shrink-0"
      aria-label="Re-Vision Digital, home"
    >
      Re<span class="text-brand-400 px-[2px]" aria-hidden="true">·</span>Vision
    </a>

    <nav class="hidden md:flex items-center gap-8">
      {headerData.links.map((link) => (
        <a href={link.href} class="text-sm font-medium text-text-muted hover:text-brand-400 transition-colors no-underline">{link.text}</a>
      ))}
    </nav>

    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden md:inline-flex items-center gap-2 bg-brand-400 hover:bg-brand-500 text-white text-sm font-semibold px-5 py-2 rounded-full transition-all no-underline"
    >

      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
      {whatsappText}
    </a>

    <button
      id="mobile-menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2"
      aria-label="Toggle mobile menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="w-5 h-0.5 bg-text rounded transition-all"></span>
      <span class="w-5 h-0.5 bg-text rounded transition-all"></span>
      <span class="w-5 h-0.5 bg-text rounded transition-all"></span>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-surface border-t border-border px-6 py-4 flex flex-col gap-4">
    {headerData.links.map((link) => (
      <a href={link.href} class="text-sm font-medium text-text-muted">{link.text}</a>
    ))}
    <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="bg-brand-400 text-white text-sm font-semibold px-5 py-2 rounded-full text-center no-underline">
      {whatsappText}
    </a>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function updateHeader() {
    if (window.scrollY > 10) {
      header?.classList.add('bg-surface', 'border-b', 'border-border', 'shadow-sm');
      header?.classList.remove('bg-transparent');
    } else {
      header?.classList.remove('bg-surface', 'border-b', 'border-border', 'shadow-sm');
      header?.classList.add('bg-transparent');
    }
  }

  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  function setMenu(open: boolean) {
    mobileMenu?.classList.toggle('hidden', !open);
    mobileBtn?.setAttribute('aria-expanded', String(open));
  }

  mobileBtn?.addEventListener('click', () => {
    setMenu(mobileMenu?.classList.contains('hidden') ?? false);
  });

  mobileMenu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setMenu(false));
  });

  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });
</script>
