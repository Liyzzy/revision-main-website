---
import MainLayout from '../layouts/MainLayout.astro';

const title = 'About Us — Re-Vision Digital';
---

<MainLayout title={title}>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-20">
    <h1 class="text-4xl font-bold font-display mb-4">About Re-Vision Digital</h1>
    <p class="text-lg text-text-muted mb-4">
      We're a Sabah-based web team building fast, modern websites for local businesses —
      warungs, cafes, clinics, and other SMEs that want a professional online presence
      without the usual agency price tag.
    </p>
    <p class="text-lg text-text-muted">
      This page is still a placeholder. Add your team story, mission, and photos here.
    </p>
  </section>
</MainLayout>
