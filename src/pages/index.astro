---
import MainLayout from '../layouts/MainLayout.astro';
import Hero from '../components/widgets/Hero.astro';

const title = 'Re-Vision Digital | WaaS Agency in Sabah';
---

<MainLayout title={title}>

  <!-- Hero Widget -->
  <!-- No hero image yet — drop one in public/ and pass
       image={{ src: '/your-image.png', alt: '...' }} once you have it. -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'WhatsApp Up',
        href: 'https://wa.me/60123456789',
        target: '_blank',
        icon: 'tabler:brand-whatsapp',
      },
      { text: 'Lihat Pakej', href: '#pricing' },
    ]}
  >
    <Fragment slot="title">
      Digitalize Your Business with Us
    </Fragment>
    
    <Fragment slot="subtitle">
      We build professional websites for warungs, cafes, and clinics as low as RM199/month.
    </Fragment>
  </Hero>

</MainLayout>