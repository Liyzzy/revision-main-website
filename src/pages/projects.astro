---
import MainLayout from '../layouts/MainLayout.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import { projects } from '../data/projects';

const title = 'Our Projects - Re-Vision Digital';
---

<MainLayout title={title}>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 py-20">
        <h1 class="text-4xl font-bold font-display mb-4">Our Work</h1>

        <p class="text-lg text-text-muted mb-10">
            Demo sites we've built to show what's possible. Each one is a real working
            website, not a mockup. Yours would be built the same way, with your own
            name, photos and prices.
        </p>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {projects.map((project) => <ProjectCard {...project} />)}
        </div>
    </section>
</MainLayout>
