---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/ui/Button.astro';
import ContactForm from '../components/widgets/ContactForm.astro';
import { whatsappLink } from '../navigation';

const title = 'Contact Our Team - Re-Vision Digital';
---

<MainLayout title={title}>

  <section class="max-w-2xl mx-auto px-4 sm:px-6 pt-20 pb-12 text-center">

    <h1 class="text-4xl font-bold font-display mb-6">Get in Touch</h1>
    <p class="text-lg text-text-muted mx-auto mb-8">
      Tell us what your business does and we'll tell you what it would cost to get it online.
      Quotes are free and we won't chase you afterwards.
    </p>
    <Button
      variant="primary"
      href={whatsappLink('Hi Re-Vision Digital, I would like a quote.')}
      target="_blank"
      icon="tabler:brand-whatsapp"
    >
      Chat with us on WhatsApp
    </Button>
    <p class="text-sm text-text-faint mt-4">Fastest reply, usually within the hour.</p>
  </section>

  <ContactForm
    tagline="Or send a message"
    title="Tell us about your business"
    subtitle="Fill this in and we'll reply as soon as possible."
  />

</MainLayout>
