---
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/ui/Button.astro';
import { whatsappLink } from '../navigation';

const title = 'Contact Our Team - Re-Vision Digital';
---

<MainLayout title={title}>
    <section class="max-w-3xl mx-auto px-4 sm:px-6 py-20">
        <!-- Every page needs exactly one h1. This page had none, which hurts
             both SEO and screen-reader navigation. -->
        <h1 class="text-4xl font-bold font-display mb-6">Get in Touch</h1>
        <p class="text-lg text-text-muted mb-4">
            We love to hear from you! Whether you have a question about our services, want to discuss a project, or just want to say hello, feel free to reach out. Our team is here to help and we look forward to connecting with you.
        </p>
        <p class="text-lg text-text-muted mb-8">
            Please contact us for a custom quote based on your specific needs and requirements.
        </p>
        <Button variant="primary" href={whatsappLink('Hi Re-Vision Digital, I would like a quote.')} target="_blank">
            Chat with us on WhatsApp
        </Button>
    </section>
</MainLayout>
