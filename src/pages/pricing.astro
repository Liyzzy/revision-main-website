---
import MainLayout from '../layouts/MainLayout.astro';
import Pricing from '../components/widgets/Pricing.astro';
import Button from '../components/ui/Button.astro';
import { packages } from '../data/packages';
import { whatsappLink } from '../navigation';

const title = 'Pricing - Re-Vision Digital';

const faqs = [
  {
    question: 'How long does it take to build my website?',
    answer: 'Most websites are ready within 1–2 weeks, depending on the package and how quickly we get your content and feedback.',
  },
  {
    question: "What's the difference between the Starter and Growth plans?",
    answer: 'Starter gets you a clean 1-page site with the essentials — WhatsApp button, basic SEO, responsive design. Growth adds up to 5 pages, a contact form, and more room to showcase your business.',
  },
  {
    question: 'Do I need to know how to code or manage the website myself?',
    answer: "No — we handle the setup and updates for you. If you ever want to make changes yourself, we can walk you through it too.",
  },
  {
    question: 'Do you provide hosting and a domain name?',
    answer: 'Yes, hosting is included in your monthly package. A custom domain (like yourbusiness.com) can be added for a small extra fee, or you can start with the free subdomain we provide.',
  },
  {
    question: 'Can my website be in Bahasa Malaysia, English, or both?',
    answer: 'Yes, we can build your site in either language or both, depending on who your customers are.',
  },
  {
    question: 'What if I want to cancel or switch plans later?',
    answer: 'Our packages are billed monthly with no long-term lock-in contract — you can upgrade, downgrade, or cancel anytime.',
  },
];
---

<MainLayout title={title}>
    <Pricing
      headingLevel="h1"
      title="Packages and Prices"
      subtitle="Simple monthly pricing. No long-term contract — upgrade, downgrade or cancel anytime."
      items={packages}
    >
    <Button
      slot="action"
      variant="secondary"
      href={whatsappLink('Hi Re-Vision Digital, I am not sure which plan fits my business. Can you help?')}
      target="_blank"
      icon="tabler:brand-whatsapp"
    >
      Not sure which plan? Ask us
    </Button>
  </Pricing>

    <section id="faq" class="py-16 bg-background scroll-mt-20">
      <div class="container mx-auto px-4 max-w-3xl">
        <h2 class="text-3xl font-bold mb-8 text-center">Frequently Asked Questions</h2>
        <div>
          {faqs.map((faq) => (
            <div class="border-b border-border py-4">
              <h3 class="font-semibold mb-2">{faq.question}</h3>
              <p class="text-text-muted">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
</MainLayout>
